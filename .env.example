# Nimbus Control Plane configuration.
#
# Copy this file to `.env` and adjust the values for your machine:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. The control plane reads
# configuration from real environment variables only; it does not parse `.env`
# itself. Load the file into your shell before starting the service:
#
#     set -a && source .env && set +a
#
# See docs/development.md for the full local setup walkthrough.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment. One of: development, staging, production.
# Also selects the log format (development => text, otherwise => JSON).
NIMBUS_ENV=development

# Minimum log level. One of: debug, info, warn, error.
NIMBUS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Control plane HTTP server
# ---------------------------------------------------------------------------

NIMBUS_CONTROL_PLANE_HOST=0.0.0.0
NIMBUS_CONTROL_PLANE_PORT=8080

# How long in-flight requests are given to finish during a graceful shutdown.
NIMBUS_CONTROL_PLANE_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

NIMBUS_DATABASE_HOST=localhost
NIMBUS_DATABASE_PORT=5432
NIMBUS_DATABASE_NAME=nimbus
NIMBUS_DATABASE_USER=nimbus

# Required. There is no default: the control plane refuses to start without it,
# so that no credential is ever baked into the source tree.
NIMBUS_DATABASE_PASSWORD=nimbus

# libpq SSL mode. `disable` is appropriate for the local Docker Compose
# database; use `require` or stricter against a real deployment.
NIMBUS_DATABASE_SSL_MODE=disable

# Connection pool tuning and the timeout applied to connectivity checks
# (startup validation and the GET /ready probe).
NIMBUS_DATABASE_MAX_OPEN_CONNS=25
NIMBUS_DATABASE_MAX_IDLE_CONNS=5
NIMBUS_DATABASE_CONN_MAX_LIFETIME=30m
NIMBUS_DATABASE_CONNECT_TIMEOUT=5s
