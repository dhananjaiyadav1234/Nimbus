# Nimbus configuration — both the Control Plane (cmd/control-plane) and the
# Node Agent (cmd/node-agent) read theirs from environment variables, listed
# below in that order.
#
# Copy this file to `.env` and adjust the values for your machine:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Neither process parses
# `.env` itself — they read real environment variables only. Load the file
# into your shell before starting either one:
#
#     set -a && source .env && set +a
#
# See docs/development.md for the full local setup walkthrough, including
# how to run several Node Agents at once, and docs/cluster-membership.md for
# what each cluster-membership setting actually controls.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment. One of: development, staging, production.
# Also selects the log format (development => text, otherwise => JSON).
NIMBUS_ENV=development

# Minimum log level. One of: debug, info, warn, error.
NIMBUS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Control plane HTTP server
# ---------------------------------------------------------------------------

NIMBUS_CONTROL_PLANE_HOST=0.0.0.0
NIMBUS_CONTROL_PLANE_PORT=8080

# How long in-flight requests are given to finish during a graceful shutdown.
NIMBUS_CONTROL_PLANE_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

NIMBUS_DATABASE_HOST=localhost
NIMBUS_DATABASE_PORT=5432
NIMBUS_DATABASE_NAME=nimbus
NIMBUS_DATABASE_USER=nimbus

# Required. There is no default: the control plane refuses to start without it,
# so that no credential is ever baked into the source tree.
NIMBUS_DATABASE_PASSWORD=nimbus

# libpq SSL mode. `disable` is appropriate for the local Docker Compose
# database; use `require` or stricter against a real deployment.
NIMBUS_DATABASE_SSL_MODE=disable

# Connection pool tuning and the timeout applied to connectivity checks
# (startup validation and the GET /ready probe).
NIMBUS_DATABASE_MAX_OPEN_CONNS=25
NIMBUS_DATABASE_MAX_IDLE_CONNS=5
NIMBUS_DATABASE_CONN_MAX_LIFETIME=30m
NIMBUS_DATABASE_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Cluster membership (Control Plane)
# ---------------------------------------------------------------------------

# How often a Node Agent is told to heartbeat. The Control Plane's response
# to POST /nodes/register carries this value; agents adopt it, so changing
# it here changes agent behaviour too without touching the agent's own config.
NIMBUS_HEARTBEAT_INTERVAL=10s

# How many consecutive missed intervals before a node is marked NotReady.
# timeout = NIMBUS_HEARTBEAT_INTERVAL * NIMBUS_HEARTBEAT_FAILURE_THRESHOLD
# (10s * 3 = 30s with the defaults below). See docs/cluster-membership.md.
NIMBUS_HEARTBEAT_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# Node Agent (cmd/node-agent) — unused by the Control Plane
# ---------------------------------------------------------------------------

# Base URL of the Control Plane this agent registers and heartbeats against.
NIMBUS_CONTROL_PLANE_URL=http://localhost:8080

# Where this agent persists its local identity (identity.json). Running
# several agents on one machine to simulate a multi-node cluster means
# giving each one a *different* data directory — see docs/development.md.
NIMBUS_NODE_DATA_DIR=./.nimbus

# Overrides the hostname this agent reports to the Control Plane. Optional;
# empty means "use the machine's real hostname" (os.Hostname()). Several
# simulated agents on the same machine need this set to distinct values, or
# they would all report the same real hostname.
NIMBUS_NODE_NAME=

# This agent's own heartbeat cadence before its first successful
# registration. Once registered, the Control Plane's own interval (above)
# takes over — this value is only ever a startup fallback.
# (Reuses NIMBUS_HEARTBEAT_INTERVAL: both processes read the same variable,
# each for its own purpose, rather than needing two separate ones.)

# Reported to the Control Plane at registration.
NIMBUS_AGENT_VERSION=0.1.0
